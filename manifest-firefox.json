{
  "manifest_version": 2,
  "name": "Content Shield",
  "version": "1.0.0",
  "description": "A powerful content filtering extension to protect your browsing experience and block inappropriate websites.",
  
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "alarms",
    "<all_urls>"
  ],
  
  "background": {
    "scripts": ["browser-polyfill.js", "utils.js", "background.js"],
    "persistent": false
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["browser-polyfill.js", "utils.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Content Shield"
  },
  
  "options_page": "options.html",
  
  "icons": {
    "128": "imgs/icon128.png"
  },
  
  "web_accessible_resources": [
    "blocked.html",
    "blocked.css",
    "blocked.js"
  ],
  
  "content_security_policy": "script-src 'self'; object-src 'self'",
  
  "applications": {
    "gecko": {
      "id": "contentshield-extension@mozilla.org",
      "strict_min_version": "78.0"
    }
  }
}
